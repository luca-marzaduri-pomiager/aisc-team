/.idea/
def_plugins/

# Local configuration and secrets. Keep sanitized templates versioned.
# Already tracked files must also be removed from the Git index separately.
.env
.env.*
env.*
!env.sh
!.env.example
!.env.sample
!.env.template
!env.example
!env.sample
!env.template
!env.*.example
!env.*.sample
!env.*.template

# Local credentials and private keys
.aws/
.ssh/
secrets/
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Dependencies, Python caches and virtual environments
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated output, logs and coverage
*.log
.coverage
.coverage.*
htmlcov/
coverage/

