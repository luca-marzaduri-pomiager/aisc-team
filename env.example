# Optional overrides. Compose works without this file or a .env file.
# Copy to .env only when you want to change the local defaults.
AISC_PORT=8092
# Optional existing public catalogue URL. No catalogue service is started.
CATALOG_URL=
POSTGRES_USER=aisc
POSTGRES_PASSWORD=LocalPostgres1!
S3_USER=aisc-storage
S3_PASSWORD=LocalStorage1!
RABBITMQ_USERNAME=aisc
RABBITMQ_PASSWORD=LocalRabbit1!
IMMUDB_ADMIN_PASSWORD=LocalImmu1!
DJANGO_SECRET_KEY=local-demo-secret-key-change-before-sharing-publicly
INTERNAL_API_KEY=local-demo-internal-api-key
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
QUALIFICATION_LLM_MODEL=mistral/mistral-large-latest
